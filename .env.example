# ====================================================================
# BIRTHDAY INVITATION CONFIGURATION & ENVIRONMENT VARIABLES
# ====================================================================

# Supabase PostgreSQL & Auth Configuration
# Paste your Supabase project URL and keys from your Supabase Dashboard:
# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Note: Admin login at /admin/login authenticates exclusively against your Supabase Auth users.
# Create an admin user under Supabase Dashboard -> Authentication -> Users.

# Session security secret (random string for signing session tokens)
SESSION_SECRET=bossman-laxman-50-secret-key-2026-super-secure
